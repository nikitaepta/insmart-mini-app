
# ===== Telegram Bot =====
BOT_TOKEN=your-telegram-bot-token-here

# ===== Telegram Mini App URL =====
# Локально или ссылка на GitHub Pages
WEB_APP_URL=https://nikitaepta.github.io/insmart-mini-app/?v=2


# ===== Inssmart API — способы авторизации (в порядке рекомендуемости) =====

# ---------------------------------------------------------------------------
# 🔥 СПОСОБ 1 (РЕКОМЕНДУЕТСЯ): явный endpoint авторизации + телефон/пароль
# ---------------------------------------------------------------------------
# Сервер сам перебирает 24+ URL авторизации × 4 формата телефона × 3 user-поля
# × 3 Content-Type — но если ТЫ ЗНАЕШЬ ТОЧНЫЙ URL логина — подставь его,
# и он будет проверен САМЫМ ПЕРВЫМ (до всех догадок, экономит 30-60 секунд).
#
# Как узнать ТОЧНЫЙ URL:
#   1. Открой https://partners.inssmart.ru  в браузере (Chrome/Edge).
#   2. Нажми F12 → вкладка Network (Сеть).
#   3. Введи свой телефон/пароль в форму и нажми «Войти».
#   4. В списке Network появятся новые строки. Найди первую строку с:
#        Method = POST
#        Status = 200 (или 401, если пароль неверный — тоже подойдёт)
#        Name   = что-то вроде token | login | signin
#   5. Кликни по ней → на вкладке Headers (Заголовки) скопируй строку:
#        Request URL: https://api.inssmart.ru/v1/.....
#   6. Вставь её сюда ↓
#
# INSSMART_LOGIN_URL=https://api.inssmart.ru/v1/account/accounts/token

# ---------------------------------------------------------------------------
# ⚡ СПОСОБ 2: Ручной JWT на 1 час (из браузера) — для быстрой проверки
# ---------------------------------------------------------------------------
# F12 → Network → клик по любому XHR-запросу → вкладка Headers →
# Request Headers → Authorization: Bearer eyJhbGciOiJIUzI1NiIs....
# Скопируй ВСЁ после Bearer и вставь сюда.
#
# INSSMART_BEARER_TOKEN=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxxxxx.yyyyyyyyyyyyy

# ---------------------------------------------------------------------------
# 🛠 СПОСОБ 3 (по умолчанию): Телефон + пароль (сервер перебирает все варианты)
# ---------------------------------------------------------------------------
INSSMART_PHONE=79000000000
INSSMART_PASSWORD=your-password-here
INSSMART_LOCATION=Россия, Москва
INSSMART_DOMAIN=partners

# Если «Способ 1» (INSSMART_LOGIN_URL) не помог и всё равно 401 — скопируй
# из DevTools запроса login: ПКМ → Copy → Copy as cURL (bash) — и пришли
# мне этот curl. Я перенесу все headers/cookies/поля тела в код, и авторизация
# будет 1-в-1 как в браузере.


# ===== Backend URL, к которому обращается бот за офферами =====
# Локально: http://localhost:8000
# На Railway: https://your-project.up.railway.app
BACKEND_API_URL=http://localhost:8000
