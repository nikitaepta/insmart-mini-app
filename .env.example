
# ===== Telegram Bot =====
BOT_TOKEN=your-telegram-bot-token-here

# ===== Telegram Mini App URL =====
# Локально или ссылка на GitHub Pages
WEB_APP_URL=https://nikitaepta.github.io/insmart-mini-app/?v=2


# ===== Inssmart API — ДВА СПОСОБА АВТОРИЗАЦИИ (выбери ОДИН) =====

# СПОСОБ 1 (рекомендуется, самый надёжный): ручной JWT из браузера.
# 1. Открой https://partners.inssmart.ru и войди в свой аккаунт.
# 2. F12 → вкладка Network → кликни по любому XHR-запросу.
# 3. В заголовке Request Headers найди Authorization: Bearer eyJhbGciOiJ...
# 4. Скопируй ВСЮ строку после Bearer (три блока через точку).
# 5. Вставь сюда. Так ты точно обойдёшь проблемы с endpoint-ом логина.
#
# INSSMART_BEARER_TOKEN=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.....

# СПОСОБ 2 (если нет ручного токена): телефон и пароль.
# Сервер переберёт 6 возможных URL и 3 формата запроса,
# пока не найдёт работающий вариант.
INSSMART_PHONE=79000000000
INSSMART_PASSWORD=your-password-here
INSSMART_LOCATION=Россия, Москва
INSSMART_DOMAIN=partners


# ===== Backend URL, к которому обращается бот за офферами =====
# Локально: http://localhost:8000
# На Railway: https://your-project.up.railway.app
BACKEND_API_URL=http://localhost:8000
