
# =========================================================
# Самый ВАЖНЫЙ раздел на сегодня: обход WAF Инсарта (503)
# =========================================================
# Inssmart банит облачные IP (Railway / AWS / GCP) → ошибка 503 Service Unavailable.
# Поэтому выбираем ОДИН из 4 способов ниже (по простоте сверху → вниз).

# ----------------------------------------------------------------
# ✅ СПОСОБ 0 (САМЫЙ ПРОСТОЙ): запустить всё ЛОКАЛЬНО у себя дома.
# ----------------------------------------------------------------
#   — Не нужен Railway вообще (или нужен только для bot.py без FastAPI).
#   — Твой домашний IP не забанен.
#   — Запускаешь у себя 2 окна PowerShell:
#       Окно 1:  uvicorn server:app --port 8000
#       Окно 2:  python bot.py
#   — В BACKEND_API_URL оставляешь http://localhost:8000
#   — Бот офлайн пока комп выключен, но работает надёжно.

# ----------------------------------------------------------------
# ✅ СПОСОБ 1 (публичный + бесплатно): TOKEN PROXY на домашнем ПК
# ----------------------------------------------------------------
#   — Railway сервер запущен публично / Mini App с GitHub Pages → нужен доступ из внешней сети.
#   — На домашнем ПК один раз запускаешь scripts/token_proxy.py:
#       .venv\Scripts\activate
#       python scripts\token_proxy.py
#   — Пробрасываешь порт 8787 на роутере или используешь ngrok free:
#       ngrok http 8787   →   даст https://xxxx.ngrok-free.app
#   — Устанавливаешь в Railway Variables:
#       INSSMART_TOKEN_EXTERNAL_URL=https://xxxx.ngrok-free.app/token
#       (доп. защита) TOKEN_PROXY_API_KEY=мой_секрет
#       (доп. защита) Railway INSSMART_TOKEN_EXTERNAL_URL=.../token?key=мой_секрет

# ----------------------------------------------------------------
# ✅ СПОСОБ 2 (публичный + дешёвый): Residential/static proxy РФ
# ----------------------------------------------------------------
#   Купи proxy за 50-300₽/мес (любой магазин proxy РФ).
#   Формат:  http://user:password@host:port
#            socks5h://user:password@host:port
#   Установи в Railway Variables:
#       INSSMART_PROXY_URL=http://user:pass@1.2.3.4:12345

# ----------------------------------------------------------------
# ⚡ СПОСОБ 3 (быстрый на 1 час): Ручной JWT
# ----------------------------------------------------------------
# F12 → Network → клик по XHR → Request Headers → Authorization →
# Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxx.yyy  → вставь ниже.
#
# INSSMART_BEARER_TOKEN=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9......

# ----------------------------------------------------------------
# 🛠 Авто-перебор 24×URL×36вариантов (для локального/прокси запуска)
# ----------------------------------------------------------------
# Если знаешь ТОЧНЫЙ endpoint логина (смотри F12 Network → Request URL)
# → вставь, он проверяется самым первым:
#
# INSSMART_LOGIN_URL=https://api.inssmart.ru/v1/account/accounts/token

INSSMART_PHONE=79000000000
INSSMART_PASSWORD=your-password-here
INSSMART_LOCATION=Россия, Москва
INSSMART_DOMAIN=partners


# ===== Telegram Bot =====
BOT_TOKEN=your-telegram-bot-token-here

# ===== Telegram Mini App URL =====
WEB_APP_URL=https://nikitaepta.github.io/insmart-mini-app/?v=2

# ===== Backend URL, к которому обращается бот за офферами =====
# Локально:   http://localhost:8000
# На Railway: https://your-project.up.railway.app
BACKEND_API_URL=http://localhost:8000
